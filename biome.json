{
	"files": {
		"includes": [
			"src/**/*.ts",
			"src/**/*.tsx",
			"tests/**/*.ts",
			"watchface/**/*.mjs",
			"*.mjs",
			"*.ts"
		]
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"security": {
				"noDangerouslySetInnerHtml": "off"
			},
			"suspicious": {
				"noExplicitAny": "off"
			}
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "off"
			}
		}
	}
}
